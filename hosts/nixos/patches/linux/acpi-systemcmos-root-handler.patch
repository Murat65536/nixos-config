+	 */
+	status = acpi_install_address_space_handler(ACPI_ROOT_OBJECT,
 						    ACPI_ADR_SPACE_CMOS,
 						    acpi_cmos_rtc_space_handler,
 						    NULL, NULL);
@@ -79,7 +83,7 @@ static int acpi_cmos_rtc_attach(struct acpi_device *adev,
 {
 	int ret;
 
-	ret = acpi_install_cmos_rtc_space_handler(adev->handle);
+	ret = acpi_install_cmos_rtc_space_handler();
 	if (ret < 0)
 		return ret;
 
